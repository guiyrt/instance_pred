#INTENT__SESSION_PATH=/mnt/c/Users/regd/Documents/Data/001/3

# Server mode
INTENT__GAZE_ZMQ_HOST=tcp://localhost:5555
INTENT__ASD_NATS_HOST=nats://localhost:4222

# Parquet Sink Configuration
INTENT__PARQUET__ENABLED=true
