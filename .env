# Offline mode
INTENT__SESSION_PATH=/mnt/c/Users/regd/Documents/Data/001/3

# Server mode
INTENT__HOST=0.0.0.0
INTENT__WEB_PORT=8000
INTENT__GAZE_ZMQ_HOST=tcp://host.docker.internal:5555

# Parquet Sink Configuration
INTENT__PARQUET__ENABLED=true
INTENT__PARQUET__OUTPUT_DIR=.data
INTENT__PARQUET__MAX_TIME_FLUSH_SEC=30

# Terminal Sink Configuration
INTENT__TERMINAL__ENABLED=true
INTENT__TERMINAL__REFRESH_PER_SEC=10
INTENT__TERMINAL__TOP_N=5

# Logging
INTENT__LOGGING__LEVEL=DEBUG